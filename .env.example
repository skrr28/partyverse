# Copia este archivo como .env.local y rellena los valores de TU proyecto de Supabase.
# Ambos valores son públicos por diseño (van dentro de la app).
# NUNCA pongas aquí la contraseña de la base de datos ni la clave secreta / service_role.
#
# Dónde encontrarlos: Supabase Dashboard → Project Settings → API (o "Connect").

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
